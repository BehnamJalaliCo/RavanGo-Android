<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RavanGo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/rg_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.RavanGo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rg_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.RavanGo</item>
    </style>
</resources>
